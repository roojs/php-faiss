-include php_faiss.dep
php_faiss.lo: /home/leon/gitlive/php-fiass/php_faiss.c
	$(LIBTOOL) --tag=CC --mode=compile $(CC) -I. -I/home/leon/gitlive/php-fiass $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS)   -DZEND_COMPILE_DL_EXT=1 -c /home/leon/gitlive/php-fiass/php_faiss.c -o php_faiss.lo  -MMD -MF php_faiss.dep -MT php_faiss.lo
-include faiss_c_wrapper.dep
faiss_c_wrapper.lo: /home/leon/gitlive/php-fiass/faiss_c_wrapper.cpp
	$(LIBTOOL) --tag=CXX --mode=compile $(CXX) -I. -I/home/leon/gitlive/php-fiass $(COMMON_FLAGS) $(CXXFLAGS_CLEAN) $(EXTRA_CXXFLAGS)   -DZEND_COMPILE_DL_EXT=1 -c /home/leon/gitlive/php-fiass/faiss_c_wrapper.cpp -o faiss_c_wrapper.lo  -MMD -MF faiss_c_wrapper.dep -MT faiss_c_wrapper.lo
$(phplibdir)/faiss.la: ./faiss.la
	$(LIBTOOL) --tag=CC --mode=install cp ./faiss.la $(phplibdir)

./faiss.la: $(shared_objects_faiss) $(FAISS_SHARED_DEPENDENCIES)
	$(LIBTOOL) --tag=CC --mode=link $(CC) -shared $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS) $(LDFLAGS)  -o $@ -export-dynamic -avoid-version -prefer-pic -module -rpath $(phplibdir) $(EXTRA_LDFLAGS) $(shared_objects_faiss) $(FAISS_SHARED_LIBADD)

